# Copy this file to .env and set the URL your PHONE can actually reach.
#
# During local demo (phone + laptop on the same Wi-Fi), set this to your
# laptop's LAN IP, e.g.:
#   VITE_PUBLIC_URL=http://192.168.1.23:5173/feedback
#
# If left blank, the QR page falls back to `${window.location.origin}/feedback`,
# which works fine as long as you open the /qr page itself via the LAN IP
# (not "localhost" — a phone cannot resolve your laptop's localhost).
#
# For a real deployment, set it to your production URL instead:
#   VITE_PUBLIC_URL=https://lobbyloop.yourdomain.com/feedback

VITE_PUBLIC_URL=
